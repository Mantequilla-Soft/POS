# Server
PORT=3001

# MongoDB — change to your connection string
MONGODB_URI=mongodb://localhost:27017/poshive

# JWT — use a long random string in production
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRY=7d

# CORS — set to your frontend domain(s) in production, or keep * for open access
CORS_ORIGIN=*

# The username that automatically gets superadmin on first login
SUPERADMIN_USERNAME=your-hive-username

# Public URL of this server — used to build absolute image URLs (no trailing slash)
# In production set this to your domain, e.g. https://api.yourdomain.com
PUBLIC_URL=http://localhost:3001

# Email / SMTP — required for overdue membership reminders
# Works with any SMTP provider. SendGrid example shown below (free tier: 100 emails/day)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=apikey
EMAIL_PASS=your-sendgrid-api-key
EMAIL_FROM=noreply@yourdomain.com

# How often the daily reminder cron fires (cron expression, default: 9am UTC daily)
REMINDER_CRON=0 9 * * *

# Minimum days between reminders for the same member (default: 7)
REMINDER_INTERVAL_DAYS=7

# Server timezone for cron scheduling (e.g. America/Guayaquil, America/New_York)
TZ=UTC

# ── Subscription / Billing ────────────────────────────────────────────────────
# Set to false to disable billing entirely (for self-hosted deployments)
BILLING_ENABLED=true

# Hive account that receives HBD subscription payments
BILLING_HIVE_ACCOUNT=your-hive-billing-account

# Monthly price in HBD (default: 5)
BILLING_PLAN_PRICE=5

# Free trial length in days for new stores (default: 30)
BILLING_TRIAL_DAYS=30

# How often to mark expired trials/periods as overdue (default: every hour)
BILLING_OVERDUE_CRON=0 * * * *

# How often to poll Hive blockchain for incoming payments (default: every 10 min)
BILLING_POLL_CRON=*/10 * * * *

# Stripe (optional — leave blank to disable card payments)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
