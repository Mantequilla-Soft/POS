# Server
PORT=3001

# MongoDB — change to your connection string
MONGODB_URI=mongodb://localhost:27017/poshive

# JWT — use a long random string in production
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRY=7d

# CORS — set to your frontend domain(s) in production, or keep * for open access
CORS_ORIGIN=*

# The username that automatically gets superadmin on first login
SUPERADMIN_USERNAME=your-hive-username
